    let rec lemma prod_nth_drop_relation (lst: list int) (n:int)
    requires { 0 <= n < length lst }
    ensures { prod (drop lst n) = my_nth n lst * prod (drop lst (n + 1)) }
    variant { lst }
    =
        match lst with
            | Nil -> ()
            | Cons h t ->
                if n = 0 then
                    ()
                else
                    prod_nth_drop_relation t (n - 1)
        end

    (*
    lemma prod_nth_drop_relation:
        forall lst: list int, n:int.
            0 <= n < length lst ->
            prod (drop lst n) = my_nth n lst * prod (drop lst (n + 1))
    *)

    let rec ghost function x_coords (y_shape  y_coords  x_shape: list int) (index: int) (flat_index: int) : list int
    requires { positive x_shape }
    requires { positive y_shape }
    requires { valid y_coords y_shape }
    requires { length y_shape = length y_coords }
    requires { 0 <= index <= length x_shape }
    requires { partial_prod x_shape 0 = partial_prod y_shape 0 }
    requires { 0 <= flat_index < partial_prod x_shape index }
    variant { length x_shape - index }
    ensures { length result = length x_shape - index }
    ensures { index < length x_shape -> 
              let flat_index_ = flat_index - my_nth 0 result * partial_prod x_shape (index + 1) in
              0 <= flat_index_ < partial_prod x_shape (index + 1)
          }
    ensures { forall i:int. 0 <= i < length result -> 0 <= my_nth i result < my_nth (i + index) x_shape }
    =
    if index = length x_shape then
        Nil
    else
        let prod_dropped = partial_prod x_shape (index + 1) in
        let x_coord = div flat_index prod_dropped in
        let flat_index_ = flat_index - x_coord * prod_dropped in
        Cons x_coord (x_coords  y_shape  y_coords  x_shape  (index + 1) flat_index_ )

    
    let ghost function dreshape (s: tensor int) (x: tensor int) (y_shape_list: list int) : data int
    (*1D Shape*)
    requires { length s.dims = 1 }
    (*X Shape can be 0 or positive*)
    requires { non_negative x.dims }
    (* Prod y_shape is equal to prod x_shape*)
    requires { prod y_shape_list = prod x.dims }
    =
        fun ks ->
            if valid ks y_shape_list then
                let flat_index = flatIndexBounded (length y_shape_list) y_shape_list ks in
                let x_coords = x_coords y_shape_list ks x.dims 0 flat_index in
                x.data x_coords
            else
                x.background
    
    let ghost function reshape (x:tensor int) (s:tensor int) (allowzero: int) : tensor int
    (*1D Shape*)
    requires { length s.dims = 1 }
    (*X Shape can be 0 or positive*)
    requires { non_negative x.dims }
    (*S Domain Value*)
    requires { forall ks: list int. valid ks s.dims -> (s.data ks >= -1) }
    (*Mapping Values need to be valid in x_shape*)
    requires { forall ks: list int. valid ks s.dims /\ allowzero = 0 /\ s.data ks = 0 -> 0 <= my_head ks < length x.dims }
    (* If allowzero is 1 then we either have minus one or zeros *)
    requires { allowzero = 1 -> (check_for_minus_one s.data s.dims -> not check_for_zero s.data s.dims) }
    (* If allowzero is 0 then we either have minus one or zeros *)
    requires { allowzero = 0 -> (check_for_minus_one s.data s.dims -> positive x.dims) }
    (* If allowzero is 0 then all values in s are either positive or -1 *)
    requires { allowzero = 0 /\ (positive x.dims)  -> (forall js: list int. valid js s.dims -> s.data js >= -1) }
    (* If allowzero is 0 if we have zeros on x_shape we have a zero on s that maps to 0 on x_shape, and viceverse *)
    requires { allowzero = 0 -> ((not positive x.dims) <-> (exists ks: list int. valid ks s.dims /\ s.data ks = 0 /\ ks <> Nil /\ my_nth (my_head ks) x.dims = 0)) }
    (* If allowzero is 1 if we have zeros on x_shape we have zeros on s, and vice-versa *)
    requires { allowzero = 1 -> (check_for_zero s.data s.dims <-> (not positive x.dims)) }
    (* Allowzero is 1 or 0 *)
    requires { allowzero = 0 \/ allowzero = 1 }
    (* All -1 values are unique *)
    requires { forall i,j:list int. valid i s.dims /\ valid j s.dims /\ s.data i = -1 /\ s.data j = -1 -> i = j }
    (*Product Conditions*)
    requires { (check_for_minus_one s.data s.dims /\ allowzero = 1) ->  mod (prod x.dims) (map_prod 0 s.data s.dims) = 0 }
    requires { (check_for_minus_one s.data s.dims /\ allowzero = 0 ) ->  mod (prod x.dims) (map_prod_zero 0 s.data s.dims x.dims) = 0 }

    requires { ((not check_for_minus_one s.data s.dims) /\ allowzero = 1) -> prod x.dims = map_prod 0 s.data s.dims }
    requires { ((not check_for_minus_one s.data s.dims) /\ allowzero = 0) -> prod x.dims = map_prod_zero 0 s.data s.dims x.dims }
    =
        let y_dims = y_shape s x.dims allowzero in
        let dreshaped_data = dreshape s x y_dims in
        { dims = y_dims; data = dreshaped_data; background = x.background }
   
end