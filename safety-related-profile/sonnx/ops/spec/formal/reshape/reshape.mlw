    let rec ghost function build_list (shape: tensor int) (ks: int) (x_shape: list int) : list int
    (* 1D Shape *)
    requires { length shape.dims = 1 }
    (*Non -1 exists on shape tensor*)
    requires { not check_for_minus_one shape.data shape.dims }
    (*X Shape can be 0 or positive*)
    requires { non_negative x_shape }
    (* Valid values for ks, is 0 <= ks < size (shape.dims) *)
    requires { 0 <= ks < size (shape.dims) }
    variant { size (shape.dims) - ks }
    (* size shape data is the same of the size of result *)
    ensures { length result = size (shape.dims) - ks }
    ensures { forall j:int. 0 <= j < length result -> my_nth j result = shape.data (Cons (ks + j) Nil) }
    ensures { prod x_shape = map_prod 0 shape.data shape.dims -> prod result = map_prod ks shape.data shape.dims }
    =
    if 0 <= ks < size (shape.dims) - 1 then
        Cons (shape.data (Cons ks Nil)) (build_list shape (ks + 1) x_shape)
    else
        Cons (shape.data (Cons ks Nil)) Nil

            
    let ghost function y_shape (s: tensor int) (x_shape: list int) (allowzero: int) : list int
    (*1D Shape*)
    requires { length s.dims = 1 }
    (*X Shape can be 0 or positive*)
    requires { non_negative x_shape }
    (*S Domain Value*)
    requires { forall ks: list int. valid ks s.dims -> (s.data ks >= -1) }
    (*Mapping Values need to be valid in x_shape*)
    requires { forall ks: list int. valid ks s.dims /\ allowzero = 0 /\ s.data ks = 0 -> 0 <= my_head ks < length x_shape }
    (* If allowzero is 1 then we either have minus one or zeros *)
    requires { allowzero = 1 -> (check_for_minus_one s.data s.dims -> not check_for_zero s.data s.dims) }
    (* If allowzero is 0 then we either have minus one or zeros *)
    requires { allowzero = 0 -> (check_for_minus_one s.data s.dims -> positive x_shape) }
    (* If allowzero is 0 then all values in s are either positive or -1 *)
    requires { allowzero = 0 /\ (positive x_shape)  -> (forall js: list int. valid js s.dims -> s.data js >= -1) }
    (* If allowzero is 0 if we have zeros on x_shape we have a zero on s that maps to 0 on x_shape, and viceverse *)
    requires { allowzero = 0 -> ((not positive x_shape) <-> (exists ks: list int. valid ks s.dims /\ s.data ks = 0 /\ ks <> Nil /\ my_nth (my_head ks) x_shape = 0)) }
    (* If allowzero is 1 if we have zeros on x_shape we have zeros on s, and vice-versa *)
    requires { allowzero = 1 -> (check_for_zero s.data s.dims <-> (not positive x_shape)) }
    (* Allowzero is 1 or 0 *)
    requires { allowzero = 0 \/ allowzero = 1 }
    (* All -1 values are unique *)
    requires { forall i,j:list int. valid i s.dims /\ valid j s.dims /\ s.data i = -1 /\ s.data j = -1 -> i = j }
    (*Product Conditions*)
    requires { (check_for_minus_one s.data s.dims /\ allowzero = 1) ->  mod (prod x_shape) (map_prod 0 s.data s.dims) = 0 }
    requires { (check_for_minus_one s.data s.dims /\ allowzero = 0 ) ->  mod (prod x_shape) (map_prod_zero 0 s.data s.dims x_shape) = 0 }
    requires { ((not check_for_minus_one s.data s.dims) /\ allowzero = 1) -> prod x_shape = map_prod 0 s.data s.dims }
    requires { ((not check_for_minus_one s.data s.dims) /\ allowzero = 0) -> prod x_shape = map_prod_zero 0 s.data s.dims x_shape }

    ensures { length result = size s.dims }
    ensures { prod result = prod x_shape }
    =
        let zero_clamp = clamp_zero allowzero s x_shape in
        let tensor_s = { dims = s.dims; data = zero_clamp; background = s.background } in
        assert { (not check_for_minus_one tensor_s.data tensor_s.dims) -> map_prod 0 tensor_s.data tensor_s.dims = prod x_shape };
        assert { check_for_minus_one tensor_s.data s.dims -> positive x_shape };
        assert { check_for_minus_one tensor_s.data s.dims -> map_prod 0 tensor_s.data tensor_s.dims = map_prod 0 zero_clamp s.dims };
        assert { check_for_minus_one tensor_s.data s.dims <-> check_for_minus_one s.data s.dims };
        if check_for_minus_one tensor_s.data s.dims then
            let final_clamp = clamp_y_shape tensor_s x_shape in
            let tensor_clamp = { dims = s.dims; data = final_clamp; background = s.background } in
            assert { map_prod 0 tensor_clamp.data tensor_clamp.dims = prod x_shape };
            build_list tensor_clamp 0 x_shape
        else 
            build_list tensor_s 0 x_shape

    
    let rec lemma valid_lists_length (l1 l2: list int)
    requires { valid l1 l2 }
    ensures { length l1 = length l2 }
    variant { l1 }
    =
        match l1, l2 with
        | Nil, Nil -> ()
        | Cons _ t1, Cons _ t2 -> valid_lists_length t1 t2
        end
    
    let rec lemma valid_lists_values (l1 l2: list int)
    requires { valid l1 l2 }
    variant { l1 }
    =
        match l1, l2 with
        | Nil, Nil -> true
        | Cons h1 t1, Cons h2 t2 -> h1 < h2 && valid_lists_values t1 t2
        end
    
    lemma valid_lists_step:
        forall l1,l2: list int, i:int.
            valid l1 l2 ->
            i > 0 ->
            match l1, l2 with
                | Cons h1 _, Cons h2 _ -> (h1 + 1) * i <= h2 * i
                | _, _ -> true
            end

    let rec ghost function flatIndexBounded (index: int) (shape: list int) (coords: list int) : int
    requires { positive shape }
    requires { valid coords shape }
    requires { 0 <= index <= length shape }
    requires { length shape = length coords }
    variant { index }
    ensures { result >= 0 }
    ensures { result < prod shape }
    =
        if index = 0 then
            0
        else
            match shape, coords with
                | Cons s ss, Cons c cc -> 
                    c * prod ss + flatIndexBounded (index - 1) ss cc
                | _, _ -> 0
            end

    let rec ghost function drop (lst: list int) (n: int): list int
    requires { 0 <= n <= length (lst) }
    ensures { length (result) = length (lst) - n }
    ensures { n = 0 -> result = lst}
    ensures { forall i:int. 0 <= i < length (result) -> my_nth i result = my_nth (i + n) lst }
    =
        match lst with
        | Nil -> Nil
        | Cons _ t ->
            if n = 0 then
                lst
            else
                drop t (n - 1)
        end

    
    let rec lemma drop_positive (lst: list int) (n: int)
    requires { positive lst }
    requires { 0 <= n <= length (lst) }
    ensures { positive (drop lst n) }
    variant { lst }
    =
        match lst with
        | Nil -> ()
        | Cons h t ->
            if n = 0 then
                ()
            else
                drop_positive t (n - 1)
        end



    let rec ghost function partial_prod (lst: list int) (n: int) : int
    requires { 0 <= n <= length lst }
    variant { n }
    ensures { result = prod (drop lst n) }
    =
        if n = 0 then
            prod lst
        else
            match lst with
                | Cons h t -> partial_prod t (n - 1)
            end
