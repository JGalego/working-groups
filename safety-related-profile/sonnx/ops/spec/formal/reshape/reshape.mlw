    lemma prod_nth_drop_relation_length_one:
        forall lst:list int, n:int.
            length(lst) = 1 ->
            0 <= n < length(lst) ->
            (*prod (drop lst n) = my_nth n lst * prod (drop lst (n + 1))*)
            match lst with
                | Cons h t -> prod (drop lst n) = h * prod (drop lst (n + 1))
                | Nil -> false
